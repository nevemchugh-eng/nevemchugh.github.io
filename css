/* =========================================
   NEVE McHUGH — PORTFOLIO
   style.css
   ========================================= */


/* ---------- RESET ---------- */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #f4f0e8;
  color: #111111;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.5;
}

a {
  color: inherit;
  text-decoration: none;
}


/* ---------- HEADER ---------- */

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 24px 40px;

  background: rgba(244, 240, 232, 0.94);

  border-bottom: 1px solid rgba(0, 0, 0, 0.15);

  z-index: 100;
}

.logo {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;

  transition: opacity 0.3s ease;
}

nav a:hover {
  opacity: 0.45;
}


/* ---------- HERO ---------- */

.hero {
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 130px 40px 45px;
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
}

.hero h1 {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(100px, 18vw, 275px);

  font-weight: 400;

  line-height: 0.72;

  letter-spacing: -0.075em;

  margin-left: -10px;
}

.hero-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  border-top: 1px solid #111;

  padding-top: 20px;
}

.hero-bottom p {
  max-width: 520px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(20px, 2vw, 30px);

  line-height: 1.25;
}

.scroll-link {
  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition: transform 0.3s ease;
}

.scroll-link:hover {
  transform: translateY(5px);
}


/* ---------- GENERAL SECTIONS ---------- */

section {
  padding: 100px 40px;
}

.section-heading {
  display: grid;

  grid-template-columns: 100px 1fr;

  align-items: baseline;

  margin-bottom: 80px;
}

.section-heading p {
  font-size: 11px;
  letter-spacing: 0.1em;
}

.section-heading h2 {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(55px, 8vw, 120px);

  font-weight: 400;

  letter-spacing: -0.05em;

  line-height: 0.9;
}


/* ---------- WORK ---------- */

.work {
  background: #111111;
  color: #f4f0e8;
}

.project {
  display: grid;

  grid-template-columns: 100px 1fr 100px;

  padding: 45px 0;

  border-top: 1px solid rgba(244, 240, 232, 0.35);

  cursor: pointer;

  transition:
    padding-left 0.4s ease,
    background 0.4s ease;
}

.project:last-child {
  border-bottom: 1px solid rgba(244, 240, 232, 0.35);
}

.project:hover {
  padding-left: 20px;
}

.project-number,
.project-year {
  font-size: 11px;
  letter-spacing: 0.1em;
}

.project-year {
  text-align: right;
}

.project-type {
  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 0.15em;

  margin-bottom: 12px;

  opacity: 0.65;
}

.project h3 {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(40px, 6vw, 90px);

  font-weight: 400;

  letter-spacing: -0.045em;

  line-height: 1;

  margin-bottom: 20px;
}

.project-description {
  max-width: 600px;

  font-size: 14px;

  line-height: 1.6;

  opacity: 0.75;
}


/* ---------- ABOUT ---------- */

.about {
  padding-top: 130px;
  padding-bottom: 130px;
}

.about-content {
  display: grid;

  grid-template-columns: 1.4fr 0.6fr;

  gap: 100px;

  align-items: start;
}

.about-intro {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(36px, 5vw, 70px);

  line-height: 1.05;

  letter-spacing: -0.035em;
}

.about-details {
  padding-top: 10px;
}

.about-details p {
  margin-bottom: 25px;

  font-size: 14px;

  line-height: 1.7;
}


/* ---------- EXPERIENCE ---------- */

.experience {
  border-top: 1px solid #111;
}

.experience-item {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 50px;

  padding: 30px 0;

  border-top: 1px solid rgba(0, 0, 0, 0.25);
}

.experience-item:last-child {
  border-bottom: 1px solid rgba(0, 0, 0, 0.25);
}

.experience-date {
  font-size: 10px;

  letter-spacing: 0.12em;

  margin-bottom: 10px;
}

.experience-item h3 {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(25px, 3vw, 45px);

  font-weight: 400;

  letter-spacing: -0.03em;
}

.experience-item > p {
  font-size: 13px;
}


/* ---------- CONTACT ---------- */

.contact {
  min-height: 90vh;

  background: #111111;
  color: #f4f0e8;

  display: flex;
  flex-direction: column;
  justify-content: center;
}

.contact h2 {
  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(65px, 11vw, 165px);

  font-weight: 400;

  line-height: 0.83;

  letter-spacing: -0.06em;

  margin: 40px 0 70px;
}

.email-link {
  width: fit-content;

  font-size: clamp(16px, 2vw, 25px);

  border-bottom: 1px solid #f4f0e8;

  padding-bottom: 6px;

  transition: opacity 0.3s ease;
}

.email-link:hover {
  opacity: 0.5;
}


/* ---------- FOOTER ---------- */

footer {
  background: #111111;
  color: #f4f0e8;

  display: flex;
  justify-content: space-between;

  padding: 25px 40px;

  border-top: 1px solid rgba(244, 240, 232, 0.3);

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 0.12em;
}

footer a {
  transition: opacity 0.3s ease;
}

footer a:hover {
  opacity: 0.5;
}


/* ---------- TEXT SELECTION ---------- */

::selection {
  background: #111111;
  color: #f4f0e8;
}


/* ---------- RESPONSIVE / MOBILE ---------- */

@media (max-width: 800px) {

  .site-header {
    padding: 20px;
  }

  nav {
    gap: 15px;
  }

  nav a {
    font-size: 9px;
  }

  .hero {
    padding: 120px 20px 30px;
  }

  .hero h1 {
    font-size: clamp(80px, 25vw, 160px);

    line-height: 0.8;

    margin-left: -5px;
  }

  .hero-bottom {
    flex-direction: column;

    align-items: flex-start;

    gap: 30px;
  }

  section {
    padding: 80px 20px;
  }

  .section-heading {
    grid-template-columns: 45px 1fr;

    margin-bottom: 50px;
  }

  .project {
    grid-template-columns: 40px 1fr;
  }

  .project-year {
    display: none;
  }

  .project:hover {
    padding-left: 0;
  }

  .about-content {
    grid-template-columns: 1fr;

    gap: 60px;
  }

  .experience-item {
    grid-template-columns: 1fr;

    gap: 15px;
  }

  .contact {
    min-height: 80vh;
  }

  footer {
    padding: 25px 20px;
  }
}


/* ---------- VERY SMALL SCREENS ---------- */

@media (max-width: 500px) {

  .logo {
    font-size: 11px;
  }

  nav a:nth-child(3) {
    display: none;
  }

  .hero h1 {
    font-size: 24vw;
  }

  .about-intro {
    font-size: 36px;
  }

  .contact h2 {
    font-size: 17vw;
  }

}
